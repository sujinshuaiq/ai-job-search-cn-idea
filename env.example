# 仅作配置示例。本工程不会自动读取此文件。
# 请在 IDEA Run Configuration 的 Environment variables 中设置，且不要提交真实密钥。
DEEPSEEK_API_KEY=sk-replace-with-your-own-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 可选
SERVER_PORT=8080
SEED_DEMO_DATA=true
H2_PASSWORD=

# Spring AI Agent（均有默认值，通常无需修改）
AGENT_MAX_TOOL_CALLS=8
AGENT_HISTORY_MESSAGES=24
AGENT_CONFIRMATION_TTL_MINUTES=30
AGENT_MAX_GOAL_CHARS=2000

# BOSS 默认离线：以下开关保持 false 时不会启动浏览器或请求 BOSS。
# 模拟人工也不能避免封号；除非明确了解风险并确认有权操作，否则不要开启。
BOSS_BROWSER_ENABLED=false
BOSS_ONLINE_ENABLED=false
